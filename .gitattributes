# Keep packaging/build scripts line-ending safe even on Windows checkouts
*.sh      text eol=lf
*.spec    text eol=lf
*.desktop text eol=lf
packaging/linux/deb/control text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf

# Binaries must never get line-ending conversion
*.pdf     binary
*.docx    binary
*.png     binary
*.ico     binary
*.dll     binary
*.exe     binary
*.gguf    binary