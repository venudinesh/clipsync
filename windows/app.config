<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Built against the 4.0 surface so it runs on Windows 7 as shipped. Every
       later 4.x is an in place upgrade, so this one line covers 4.0 through
       4.8 without a second entry. -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
