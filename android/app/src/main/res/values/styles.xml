<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown from the moment the launcher taps until Flutter's first frame.
         The background is the branded splash rather than a flat colour, so a
         cold start looks like the app arriving instead of a black rectangle.
         Light system bar icons are on here because this config's canvas is off
         white; the night variant turns them off. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <!-- Swapped in by FlutterActivity once the engine attaches. It only shows
         behind Flutter, so it wants the app canvas and nothing else. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>
</resources>
